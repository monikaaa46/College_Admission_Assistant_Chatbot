def infer_response(user_input, kb=KNOWLEDGE_BASE):
    text = user_input.lower()
    scored = [
        (rule, sum(len(kw) for kw in rule["keywords"] if kw in text),
         [kw for kw in rule["keywords"] if kw in text])
        for rule in kb
    ]
    best_rule, best_score, best_matches = max(scored, key=lambda item: item[1])
    if best_score == 0:
        return DEFAULT_RESPONSE, "Unmatched", []
    return best_rule["response"], best_rule["topic"], best_matches

